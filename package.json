{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy --env production",
    "deploy": "npm run deploy:worker && npm run build && npx wrangler pages deploy ./dist --project-name lifeos",
    "cli:build": "cd cli && npm run build",
    "cli:start": "node cli/dist/cli.js"
  },
  "dependencies": {
    "hono": "^4.8.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.80.0"
  }
}
